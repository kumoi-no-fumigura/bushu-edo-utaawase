  {
   "id": "gunsho08-bushu-edo-0003",
   "pid": "1879502",
   "pages": [
    433
   ],
   "text": "陪翁云。種桃無李實。夫太田道灌者。源三位賴政十代之後胤也。左文右武之美譽芳聲尤喧ニ于世。故於ニ武城ニ張行於此哥合。招二敬敬法師一仰判者了。自哥英雄拔群也。而今從灌公六代之孫枝。太田備中守源朝臣資宗。令手騰寫之之。八番右之和哥一篇漏脫可補之云々。寔雖似續貂尾一此番當持歟。若依之可免其罪。但後生胡廬可笑耳。光雷卿判寛永十三年五月十八日亞槐藤判興山宗善好繼勝二持ト巖勝一持一負一宗信勝一持惠仲勝二持長治持二負判者心敬講師平盛快承持三資常持一負二瑞泉坊持一負一資忠勝二右武州江戶歌合以屋代弘賢本〓",
   "poems": [],
   "lb": [
    29,
    57
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "うちさやき夕立雲もはや船はをくれてそ行奥津しほ風",
   "kana": "",
   "speaker": "",
   "page": 431,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "しくれめく雨のあら海秋はまた遠島かけてめくる雲哉",
   "kana": "",
   "speaker": "",
   "page": 431,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "しほをふく奥のくしらのわさならて一すちくもる夕立の空",
   "kana": "",
   "speaker": "",
   "page": 431,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "海原や水まくたつの雲のなみはやくもかへす夕立の雨",
   "kana": "",
   "speaker": "",
   "page": 431,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "とにかくに舟路そつらき夕立のはれてはくもる奥つしほ風",
   "kana": "",
   "speaker": "",
   "page": 431,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "見るまゝに日かけかたよる遠島やかゝりもはてぬ夕立の雲",
   "kana": "",
   "speaker": "",
   "page": 431,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "めにかゝる山さへあらぬ海原やなみにたゝよふ夕立の雲",
   "kana": "",
   "speaker": "",
   "page": 431,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "奥津なみしほひを遠み色消て雲そみちくる白雨の空",
   "kana": "",
   "speaker": "",
   "page": 431,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "海原やまきをく舟の笘さへにとりあへぬまの夕立の雨",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "音あらきなたの波路のしほ風に歸れはむかふゆふたちの空",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "たのみこし山の端さへにかきくもる奥津舟ちの夕立の空",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "きおひきぬ汐かせはやみ雲かけていそく小舟のあとの夕立",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "いかりうつほともなくてやゆふたちの跡よりかゝる沖つ舟人",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "海士小舟夕立波にかへりかれ入江をよそにぬるゝ雨かな",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "海原やつりの小舟になるかみのうをの命をやすめぬるかな",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "見る〓〓も猶かさなりて松陰の海すこしある夕立の雲",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "み山ちやむすはぬ水もをのつからこほるはかりの袖のしほ風",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "身にしめと秋夜はまたんみ山邊の夕の陰に槇の下かせ",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "風かよふ道さへたゆるしけ山も我からならすすゝの篠原",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "風のをと水のひゝきも笹の葉のみやまは夏のかけとしもなし",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "かけふかく槇立山の高ねより落くる水の音そ涼しき",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "奥はたゝむすふともなき山の井の淺くはおもひいらぬ物から",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "いかにせん又そとひこむ夏の日ももらぬ深山の槇の下庵",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "夕まくれしらぬみやまのやすらひに夏をわするゝ槇の下風",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "世中をおもひとらても山ふかみいてかてにする木〓の下かせ",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "なをさりのすゝのあみめをならせとも嵐の枕秋とたになし",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "わすれてそ秋におとろく篠のはのみやまかくれの露の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "うつり行月日もわかぬ山なから秋やゝちかき槇のした風",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "夏の日をよそにみやまのから衣たもとすゝしき瀧の音かな",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "こぬ秋に露もこほれてさゝの葉の深山のあらし面かけにたつ",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "春も猶松の雪たに消さりしみ山はまたき秋かせそ吹",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "さゝのはに霜こそあらめみしかよをいつとみやまの月の下風",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "恨めしなさても一夜のへたてなくまつと計りの月日へよとや",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "誰ために名をはとゝめん夕月夜有明まてに影をならへて",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "さりもとも待に聞こそかなしけれこぬ夜つもりの浦風の聲",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "いきてよにあすやはまたん恨てもいく有明にこりぬ命そ",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "有明の月はかりたにつれなくはふくるよ〓との空もかこたし",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "いつをさて限ならましよな〓〓を月にかこては有明のそら",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "夜をかされ待しかひなくこぬ人は我なみたこそかたみ成けれ",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "今こむとほのかたらひしみか月を有明の空に待ならへとや",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "敷妙のしのふの衣よることにまつをならへてとかぬひもかな",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "夜を重ねくつるはかりの小夜衣いかゝは夢にかへしてもみん",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "習ひこし心の程もわすられてあすとうらみんわか身ともなし",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "山のはにいく夜むなしき淚ともわか有明は人しれすして",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "かきくとき數へし夜はの心さへいかによはりて〓との葉もなき",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "有明にめくるやいくよ小車のしちをむなしき床の月影",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "今夜はと月のすかたのかはるまてたのめぬ空を詠なれぬる",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "いくめくり有明になる月そとも見さらん人は猶やまたまし",
   "kana": "",
   "speaker": "",
   "page": 432,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
